# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (PostgreSQL: local, Neon, Supabase, Railway, Render, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tempnote?schema=public"

# Application Settings
MAX_NOTE_SIZE=5242880 # 5MB limit in bytes
DEFAULT_EXPIRATION="24h"
CORS_ORIGIN="http://localhost:5173"
BASE_URL="http://localhost:5173"

# Cron Secret for /api/cron/cleanup trigger
CRON_SECRET="tempnote_super_secret_cron_key_change_in_production"
