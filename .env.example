# Server Configuration
PORT=3001
NODE_ENV=development

# Database Connection (PostgreSQL in production, or SQLite for local dev)
DATABASE_URL="file:./dev.db"

# Security & Limits
MAX_NOTE_SIZE=5242880
DEFAULT_EXPIRATION="24h"
CORS_ORIGIN="http://localhost:5173"
BASE_URL="http://localhost:5173"

# Cron Authentication (Generate a strong random 32+ character key for production)
CRON_SECRET="change_this_to_a_strong_random_secret_in_production"
